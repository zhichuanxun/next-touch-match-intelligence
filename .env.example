# Optional server-side model configuration. Copy this file to .env.
# Never commit credentials. Agent is disabled until configured.
# Choose azure, compatible, or ollama to enable a model provider.
MATCH_AI_PROVIDER=disabled
MATCH_AI_MAX_CALLS=16
MATCH_AI_MAX_TOKENS=900

# Azure adapter: set provider=azure and fill in an actual deployment.
# These are placeholders, not an existing or verified deployment.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ACCESS_TOKEN=
ENABLE_LIVE_AI=false

# Optional OpenAI-compatible endpoint: set provider=compatible.
# Configure the actual endpoint and model privately on the server.
AGENT_CHAT_ENDPOINT=
AGENT_API_KEY=
AGENT_MODEL=
AGENT_REQUEST_OPTIONS={}

PORT=3000
HOST=127.0.0.1
